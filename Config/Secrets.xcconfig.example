//
//  Secrets.xcconfig
//  NewsFlow
//
//  Copy this file to Secrets.xcconfig and add your news provider keys.
//  Secrets.xcconfig is gitignored and never committed.
//
//  Steps:
//  1. Get API keys from NewsAPI.org, The Guardian Open Platform, and NYT Developer.
//  2. Copy this file: cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//  3. Replace the placeholder values below with your actual keys.
//

NEWS_API_KEY = YOUR_API_KEY_HERE
GUARDIAN_API_KEY = YOUR_GUARDIAN_API_KEY_HERE
NYT_API_KEY = YOUR_NYT_API_KEY_HERE
