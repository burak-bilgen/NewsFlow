//
//  Secrets.xcconfig
//  NewsFlow
//
//  Copy this file to Secrets.xcconfig and add your NewsAPI.org key.
//  Secrets.xcconfig is gitignored and never committed.
//
//  Steps:
//  1. Go to https://newsapi.org and get a free API key.
//  2. Copy this file: cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//  3. Replace YOUR_API_KEY_HERE with your actual key.
//

NEWS_API_KEY = YOUR_API_KEY_HERE
